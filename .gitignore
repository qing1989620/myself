# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files —— .env 一并入库，保证在新服务器可直接复现（注意：其中的 AUTH_SECRET 已公开，
# 部署到服务器时请重新生成：openssl rand -base64 32）
.env*
!.env.example
!.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# sqlite —— dev.db 入库以保证数据可复现；备份文件不入库
*.db
!dev.db
dev.db.bak.*
uploads.bak.*.tar.gz

# user uploads —— 编辑器上传的图片与简历 PDF 需要随仓库部署，故一并入库
public/images/uploads/

# agent workspace notes (可能含密钥、密码等私密信息，禁止提交)
.workbuddy/

# 私有文件（含身份证号等敏感信息的原件，绝不入库）
.private/
